# AIPIPE_TOKEN: Required for chatbot AI calls via AI Pipe.
# Get this from https://aipipe.org/login
AIPIPE_TOKEN="your-aipipe-token"

# AIPIPE_BASE_URL: Optional override for the AI Pipe compatible endpoint.
# Use the OpenRouter path for provider-prefixed models like openai/gpt-4.1-nano-2025-04-14
AIPIPE_BASE_URL="https://aipipe.org/openrouter/v1"

# AIPIPE_MODEL: Optional override for the chatbot model.
AIPIPE_MODEL="openai/gpt-4.1-nano-2025-04-14"

# Booking notification webhook for Cloudflare/local runtime.
# Point this at your own email/webhook backend if you want booking submissions forwarded.
BOOKING_WEBHOOK_URL="https://your-webhook-endpoint"
BOOKING_NOTIFICATION_EMAIL="tr.rithvik01@gmail.com"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
